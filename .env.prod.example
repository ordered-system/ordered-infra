# Copy this file to .env.prod and fill in real values. .env.prod itself is gitignored - never
# commit it. Every value below has NO default in docker-compose.prod.yml on purpose (unlike
# local dev, where every placeholder has a "change-me" fallback) - production should fail loudly
# on startup if a secret was forgotten, not silently run with a placeholder.

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
BASE_DOMAIN=your-domain-or-ip.sslip.io

# ---------------------------------------------------------------------------
# JWT - only needs to be set on config-server now; every other service reads
# it from there. Generate a real one, e.g.: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# Stripe (order-service). Use a real test-mode secret key (sk_test_...) unless
# you're genuinely ready to take real payments (sk_live_...).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database passwords - one per service, all different. Generate with e.g.:
# openssl rand -base64 24
# ---------------------------------------------------------------------------
ORDER_DB_PASSWORD=
PRODUCT_DB_PASSWORD=
USER_DB_PASSWORD=

# ---------------------------------------------------------------------------
# MongoDB root user (engagement-service authenticates as this directly)
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=engagement_admin
MONGO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Grafana admin login (https://grafana.<BASE_DOMAIN>)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=